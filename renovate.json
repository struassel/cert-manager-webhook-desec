{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":prNotPending",
    "local>cert-manager/renovate-config"
  ],
  "dependencyDashboard": true,
  "schedule": [
    "after 6am and before 9am on monday, wednesday and friday"
  ],
  "packageRules": [
    {
      "description": "Group updates by application (based on folder name)",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Updates for {{packageFileDir}}",
      "automerge": true
    },
    {
      "description": "Major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "prCreation": "immediate",
      "labels": [
        "major-update",
        "requires-testing"
      ]
    }
  ]
}